# =========================================================
# .env.example
# Copie para ".env" e preencha com valores reais.
#
# CAMPOS OBRIGATÓRIOS (a aplicação recusa iniciar sem eles):
#   DB_PASSWORD, JWT_SECRET_KEY
# Os demais têm valor padrão sensato para desenvolvimento local.
# =========================================================

DB_HOST=localhost
DB_PORT=5432
DB_NAME=loja_roupas
DB_USER=app_loja
DB_PASSWORD=troque-essa-senha
DB_SSLMODE=prefer

JWT_SECRET_KEY=troque-essa-chave-em-producao

REDIS_HOST=localhost
REDIS_PORT=6379

RABBITMQ_HOST=localhost

INSTANCE_NAME=local
