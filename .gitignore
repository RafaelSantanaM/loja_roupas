# =========================================================
# .gitignore
# Arquivos e pastas ignorados pelo controle de versão Git.
# =========================================================

# Variáveis de ambiente reais (segredos - NUNCA versionar)
.env

# Certificados TLS / Chaves privadas locais
*.pem

# Ambiente virtual Python
venv/
.venv/

# Caches e compilação
__pycache__/
*.pyc
.pytest_cache/

# Configurações de IDEs e OS
.vscode/
.idea/
.DS_Store